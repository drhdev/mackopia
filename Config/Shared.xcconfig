MACOSX_DEPLOYMENT_TARGET = 27.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
ENABLE_HARDENED_RUNTIME = YES
ALWAYS_SEARCH_USER_PATHS = NO
COPY_PHASE_STRIP = NO
ENABLE_APP_SANDBOX = NO
// Accountless distribution: local ad-hoc integrity signatures, no Developer ID or notarization.
CODE_SIGNING_ALLOWED = YES
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
OTHER_CODE_SIGN_FLAGS = --options runtime
// Ad-hoc Hardened Runtime cannot load Xcode's separately signed debug dylib.
ENABLE_DEBUG_DYLIB = NO
DEVELOPMENT_TEAM =
MACKOPIA_BUNDLE_ID_PREFIX = com.example
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
ARCHS = arm64
#include? "Local.xcconfig"

// These targets do not yet declare App Intents. Re-enable when adding them.
LM_SKIP_METADATA_EXTRACTION = YES
