{
  "sourceLanguage": "de",
  "strings": {
    "MacKopia wird vorbereitet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacKopia is being prepared"
          }
        }
      }
    },
    "Backup-Funktionen werden in den nächsten Entwicklungsschritten eingerichtet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup features will be added in the next development steps."
          }
        }
      }
    },
    "Einstellungen folgen in einem späteren Entwicklungsschritt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings will be added in a later development step."
          }
        }
      }
    },
    "Für den Hintergrunddienst ist eine gültige App-Signatur erforderlich.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background service requires a valid app signature."
          }
        }
      }
    },
    "Der Hintergrunddienst ist nicht verfügbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background service is unavailable."
          }
        }
      }
    },
    "Der Hintergrunddienst antwortet nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background service is not responding."
          }
        }
      }
    },
    "Starte MacKopia und den Hintergrunddienst neu, um die Versionen abzugleichen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart MacKopia and the background service to align their versions."
          }
        }
      }
    },
    "Die Antwort des Hintergrunddienstes konnte nicht geprüft werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background service response could not be verified."
          }
        }
      }
    },
    "Das Speicherziel konnte nicht sicher geöffnet werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The destination could not be opened securely."
          }
        }
      }
    },
    "Das Speicherziel antwortet nicht rechtzeitig.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The destination did not respond in time."
          }
        }
      }
    },
    "Die Sicherungsfunktion konnte nicht ausgeführt werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup operation could not be performed."
          }
        }
      }
    },
    "Der Schlüsselbund ist nicht verfügbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The keychain is unavailable."
          }
        }
      }
    },
    "Die Zugangsdaten konnten nicht gespeichert werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The credentials could not be saved."
          }
        }
      }
    },
    "Der Zugriff auf den Schlüsselbund wurde abgelehnt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to the keychain was denied."
          }
        }
      }
    },
    "Das Laufwerk ist nicht verfügbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The volume is unavailable."
          }
        }
      }
    },
    "Das angeschlossene Laufwerk stimmt nicht überein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connected volume does not match."
          }
        }
      }
    },
    "Die Backup-Konfiguration ist ungültig.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup configuration is invalid."
          }
        }
      }
    },
    "Der Zugriff auf den Ordner wurde abgelehnt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to the folder was denied."
          }
        }
      }
    },
    "Der Ordner ist nicht verfügbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder is unavailable."
          }
        }
      }
    },
    "Das Speicherziel wird gerade verwendet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The destination is currently in use."
          }
        }
      }
    },
    "Ein anderer Vorgang läuft bereits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another operation is already running."
          }
        }
      }
    },
    "Die Sicherungsfunktion muss aktualisiert werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup engine needs to be updated."
          }
        }
      }
    },
    "Gib dein Backup-Passwort ein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your backup password."
          }
        }
      }
    },
    "Die Laufwerksüberwachung ist nicht verfügbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume monitoring is unavailable."
          }
        }
      }
    },
    "Die verfügbaren Quellen haben sich geändert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The available sources have changed."
          }
        }
      }
    },
    "Die Sicherung konnte nicht abgeschlossen werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup could not be completed."
          }
        }
      }
    },
    "Ein benötigtes Laufwerk ist nicht mehr verfügbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A required volume is no longer available."
          }
        }
      }
    },
    "MacKopia sichert gerade auf diesem Laufwerk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacKopia is currently using this volume for a backup."
          }
        }
      }
    },
    "Der Backup-Plan ist nicht mehr verfügbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup plan is no longer available."
          }
        }
      }
    },
    "Der Backup-Plan ist deaktiviert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup plan is disabled."
          }
        }
      }
    },
    "Der Auslöser ist nicht mehr eingerichtet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trigger is no longer configured."
          }
        }
      }
    },
    "Das Speicherziel ist nicht mehr eingerichtet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The destination is no longer configured."
          }
        }
      }
    },
    "Die Backup-Konfiguration hat sich geändert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup configuration has changed."
          }
        }
      }
    }
  },
  "version": "1.0"
}
