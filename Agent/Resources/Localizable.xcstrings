        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An operation is already running. Wait for it to finish."
          }
        }
      }
    },
    "Speicherziel oder Quelle nicht verfügbar. Prüfe Laufwerk, Ordner, freien Speicher und Backup-Passwort. Nach einem abgebrochenen Anlegen kannst du das vorhandene Ziel verbinden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Destination or source unavailable. Check the drive, folders, free space and backup password. After interrupted creation, you can connect the existing destination."
          }
        }
      }
    },
    "Eingaben ungültig. Prüfe Namen, Quellen und Speicherziel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid input. Check the name, sources and destination."
          }
        }
      }
    },
    "Backup nicht abgeschlossen. Prüfe Speicherziel und Berechtigungen und versuche es erneut.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup incomplete. Check the destination and permissions and try again."
          }
        }
      }
    },
    "Hintergrunddienst nicht aktiv. Aktiviere den Dienst oder verbinde dich erneut. Prüfe nach einer unterbrochenen Einrichtung zuerst den aktuellen Stand.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background service inactive. Enable the service or reconnect. After interrupted setup, check the current state first."
          }
        }
      }
    },
    "Dienstanfrage fehlgeschlagen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Service request failed."
          }
        }
      }
    },
    "Weiteres Speicherziel einrichten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Up Another Destination"
          }
        }
      }
    },
    "Konfigurationssicherung wiederherstellen…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Configuration Backup…"
          }
