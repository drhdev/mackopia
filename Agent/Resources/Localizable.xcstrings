    },
    "Konfiguration wiederherstellen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore configuration?"
          }
        }
      }
    },
    "Wiederherstellen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore"
          }
        }
      }
    },
    "Die letzte gültige Sicherung ersetzt die aktuelle Konfiguration. Deine Backups bleiben erhalten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last valid backup replaces the current configuration. Your backups are preserved."
          }
        }
      }
    },
    "Alle Backups pausiert": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All backups paused"
